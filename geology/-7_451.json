ac - Faciès régréssif d'Artigues, faciès à Anomies : dépôts érosifs, argiles à nodules carbonatés et marnes silteuses à débris de pecten, d'anomie (base). Présence de bryozoaires, foraminifères, ostracodes (Priabonien moy. marin)","l":"Marl","a":["Priabonian","Paleogene","Cenozoic",37.71,33.9,0],"o":100,"dp":"33","c":"#bf4000"},{"n":"e7a-Ce","d":"Groupe de Plassac - Calcaires de St Estephe : calcaire argileux crème à jaune ocre à niveaux marneux à mollusques, oursin (Echinolampas ovalis, Sismondia occitana), foraminifères (millioles, orbitolites, rotalites), ostracodes (Priabonien inf. marin)","l":"Marl","a":["Priabonian","Paleogene","Cenozoic",37.71,33.9,0],"o":104,"dp":"33","c":"#e6664d"},{"n":"e7a-Mp","d":"Groupe de Plassac - Molasse de Plassac : argiles carbonatées blanchâtres à nodules et argiles vertes (Priabonien inf. continental interstratifié dans le groupe de Plassac)","l":"Clay","a":["Priabonian","Paleogene","Cenozoic",37.71,33.9,0],"o":110,"dp":"33","c":"#ff664d"},{"n":"Fva(D)","d":"Très hautes terrasses (RD Garonne) - Terrasse d'Artigues (type 1) indiférenciée : sables, graviers, petits galets à ciment argilo-feldspathiques, argiles sableuses à galets rubéfiés (Waal - \"Donau-Gunz\")","l":"Clay","a":["Quaternary","Quaternary","Cenozoic",2.58,0,1],"o":48,"dp":"33","c":"#bfe680"},{"n":"g1-As","d":"Calcaire à Astéries : biocalcarénite détritique à rudistes, calcaire bioclastique à rhodolithes et polypiers, marno-calcaire et marne à foraminifères à intercalations molassiques ou lacustre (Rupélien marin)","l":"Marl","a":["Rupelian","Paleogene","Cenozoic",33.9,28.1,0],"o":82,"dp":"33","c":"#ffbfbf"}],"f":[{"t":"P","u":0,"c":[[[-0.64121,45.1019],[-0.64098,45.1],[-0.63869,45.1],[-0.63946,45.10058],[-0.63914,45.10317],[-0.64121,45.1019]]]},{"t":"P","u":1,"c":[[[-0.60516,45.14057],[-0.60725,45.1398],[-0.61026,45.14001],[-0.61183,45.13961],[-0.61372,45.13964],[-0.61901,45.13548],[-0.6205,45.13491],[-0.62034,45.13476],[-0.61959,45.13436],[-0.61859,45.13437],[-0.617